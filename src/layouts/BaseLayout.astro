---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'sqtds · 技术手记',
  description = '关注后端架构、分布式系统与工程实践的技术博客。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="sqtds · 技术手记" href="/rss.xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;

        // 手绘插图有浅/深两套，跟随主题切换
        const syncArt = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          document.querySelectorAll('img[data-src-dark]').forEach((img) => {
            const want = dark ? img.dataset.srcDark : img.dataset.srcLight;
            if (want && img.getAttribute('src') !== want) img.setAttribute('src', want);
          });
        };
        window.__syncArt = syncArt;
        document.addEventListener('DOMContentLoaded', syncArt);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
