---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 附加的结构化数据（如文章页的 Article schema） */
  schema?: Record<string, unknown>;
}

const {
  title = '小天的AI作坊 · 技术手记与 AI 小游戏',
  description = '小天的AI作坊：记录后端架构、分布式系统与工程实践的技术手记，也收藏用 AI 做的小游戏。',
  schema,
} = Astro.props;

const site = Astro.site ?? new URL('https://closeable.github.io');
const canonical = new URL(Astro.url.pathname, site).href;
const assetVer = 'v2';
const ogImage = new URL(`/og-default.png?${assetVer}`, site).href;
const ogType = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/' ? 'article' : 'website';
// 结构化数据：站点级（文章页的结构化数据由文章模板自行补充）
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '小天的AI作坊',
  url: site.href,
  description,
  inLanguage: 'zh-CN',
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#5b5bd6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`/favicon.svg?${assetVer}`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="小天的AI作坊" href="/rss.xml" />

    <!-- 社交分享卡片（微信/X/Twitter/Telegram 抓取这些字段） -->
    <meta property="og:site_name" content="小天的AI作坊" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <title>{title}</title>

    <!--
      站长统计：百度统计（https://tongji.baidu.com，站点 ID ec05cedf35d52e533293a32606b30594）
    -->
    <script is:inline>
      var _hmt = _hmt || [];
    </script>
    <script is:inline async src="https://hm.baidu.com/hm.js?ec05cedf35d52e533293a32606b30594"></script>

    <!-- Google Search Console 验证（纯 meta，不加载任何资源，大陆用户无感） -->
    <meta name="google-site-verification" content="OohgUhfIgKxZtNT8OYCITSqAnukcHnm2Q8sj80MeNoA" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;

        // 手绘插图有浅/深两套，跟随主题切换
        const syncArt = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          document.querySelectorAll('img[data-src-dark]').forEach((img) => {
            const want = dark ? img.dataset.srcDark : img.dataset.srcLight;
            if (want && img.getAttribute('src') !== want) img.setAttribute('src', want);
          });
        };
        window.__syncArt = syncArt;
        document.addEventListener('DOMContentLoaded', syncArt);
      })();
    </script>
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <SearchDialog />
  </body>
</html>
