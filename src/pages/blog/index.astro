---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllPosts, groupBy, tagUrl } from '../../utils/posts';

const posts = await getAllPosts();
const categories = [...groupBy(posts, (p) => p.data.category).entries()]
  .map(([name, items]) => ({ name, count: items.length }))
  .sort((a, b) => b.count - a.count);
const tags = [...groupBy(posts.flatMap((p) => p.data.tags), (tag) => tag).entries()]
  .map(([name, items]) => ({ name, count: items.length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<BaseLayout title="文章 · 小天的 AI 小作坊" description="所有文章，按分类或标签筛选，也可搜索标题、摘要与标签。">
  <div class="container">
    <div class="page-head">
      <h1>全部文章</h1>
      <p>共 {posts.length} 篇记录、{tags.length} 个标签。可按分类或标签筛选，也能搜索标题、摘要与标签。</p>
    </div>

    <div class="toolbar">
      <button class="filter-btn active" data-filter="all">全部 {posts.length}</button>
      {categories.map((c) => (
        <button class="filter-btn" data-filter={c.name}>{c.name} {c.count}</button>
      ))}
      <input class="search-input" id="search" type="search" placeholder="搜索文章…" aria-label="搜索文章" />
    </div>

    <div class="tag-section" id="tags">
      <div class="tag-section-head"><span class="tag-section-label">标签</span><span class="tag-section-hint">点标签快速筛选文章</span></div>
      <div class="tag-cloud">
        {tags.map((t) => (
          <a href={tagUrl(t.name)} data-tag={t.name}>#{t.name}<small>{t.count}</small></a>
        ))}
      </div>
    </div>

    <div class="post-grid" id="post-grid">
      {posts.map((post) => (
        <div
          class="card-wrap"
          style="display:flex"
          data-category={post.data.category}
          data-tags={post.data.tags.join('|')}
          data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}
        >
          <PostCard post={post} />
        </div>
      ))}
    </div>
    <p class="empty" id="empty" hidden>没有找到匹配的文章，换个关键词试试。</p>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const tagLinks = document.querySelectorAll<HTMLAnchorElement>('.tag-cloud a[data-tag]');
  const input = document.getElementById('search') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.card-wrap');
  const empty = document.getElementById('empty');
  let activeCategory = 'all';
  let activeTag = '';

  function apply() {
    const keyword = (input?.value ?? '').trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const tags = (card.dataset.tags ?? '').split('|');
      const matchCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
      const matchTag = !activeTag || tags.includes(activeTag);
      const matchText = !keyword || (card.dataset.search ?? '').includes(keyword);
      const show = matchCategory && matchTag && matchText;
      card.style.display = show ? 'flex' : 'none';
      if (show) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
  }

  buttons.forEach((btn) => btn.addEventListener('click', () => {
    buttons.forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    activeCategory = btn.dataset.filter ?? 'all';
    apply();
  }));

  tagLinks.forEach((link) => link.addEventListener('click', (e) => {
    e.preventDefault();
    const tag = link.dataset.tag ?? '';
    activeTag = activeTag === tag ? '' : tag;
    tagLinks.forEach((l) => l.classList.toggle('active', l.dataset.tag === activeTag));
    apply();
    document.querySelector('.post-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));

  input?.addEventListener('input', apply);
</script>

<style>
  .tag-section { margin: 8px 0 24px; }
  .tag-section-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 12px; }
  .tag-section-label { font-size: 13px; font-weight: 700; color: var(--text); }
  .tag-section-hint { font-size: 12px; color: var(--muted); }
  .tag-cloud a { cursor: pointer; }
  .tag-cloud a.active { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  .tag-cloud a.active small { color: var(--bg); }
</style>
