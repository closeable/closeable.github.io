---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, groupBy, tagUrl } from '../../utils/posts';

const posts = await getAllPosts();
const tags = [...groupBy(posts.flatMap((p) => p.data.tags), (tag) => tag).entries()]
  .map(([name, items]) => ({ name, count: items.length }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<BaseLayout title="标签 · 小天的 AI 小屋" description="按标签浏览全部文章。">
  <div class="container">
    <div class="page-head"><h1>标签</h1><p>共 {tags.length} 个标签。</p></div>
    <div class="tag-cloud">
      {tags.map((t) => <a href={tagUrl(t.name)}>#{t.name}<small>{t.count}</small></a>)}
    </div>
  </div>
</BaseLayout>
