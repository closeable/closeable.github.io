---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { games } from '../data/games';
import { prompts } from '../data/prompts';
import { getAllPosts, groupBy, categoryUrl } from '../utils/posts';

const posts = await getAllPosts();
const featured = posts.filter((p) => p.data.featured).slice(0, 3);
const shown = (featured.length ? featured : posts.slice(0, 3));
const latest = posts.slice(0, 6);
const categories = [...groupBy(posts, (p) => p.data.category).entries()]
  .map(([name, items]) => ({ name, count: items.length }))
  .sort((a, b) => b.count - a.count);
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;
const rooms = [
  { href: '/blog/', icon: '📖', title: '技术手记', desc: '架构、分布式与工程实践' },
  { href: '/games/', icon: '🎮', title: 'AI 小游戏', desc: '点开即玩，轻松一刻' },
  { href: '/prompts/', icon: '✨', title: '提示词库', desc: '结构化指令，一键复制' },
  { href: '/categories/', icon: '🗂️', title: '分类索引', desc: '按方向挑着读' },
  { href: '/about/', icon: '🏠', title: '关于作坊', desc: '这里是谁、写什么' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <span class="eyebrow"><span class="dot"></span> 代码、思考与好奇心的作坊</span>
        <h1>欢迎来到<br /><span class="gradient">小天的 AI 小作坊</span></h1>
        <p>一半是写给工程实践的技术手记，一半是用 AI 做的小游戏。把读过的论文、踩过的坑和突然冒出来的点子，一点点搬进这间作坊里。</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/games/">去玩小游戏 <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="/prompts/">翻提示词库</a>
          <a class="btn btn-ghost" href="/blog/">读技术手记</a>
        </div>
        <p class="hero-hint">想找什么？按 <kbd class="hint-mac">⌘K</kbd><kbd class="hint-win">Ctrl K</kbd> 搜遍全站</p>
        <div class="hero-stats">
          <div class="stat"><b>{posts.length}</b><span>篇文章</span></div>
          <div class="stat"><b>{games.length}</b><span>款小游戏</span></div>
          <div class="stat"><b>{prompts.length}</b><span>条提示词</span></div>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 360 300" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="wall" x1="60" y1="60" x2="300" y2="260" gradientUnits="userSpaceOnUse">
              <stop stop-color="var(--accent)" stop-opacity=".16" />
              <stop offset="1" stop-color="var(--accent-2)" stop-opacity=".06" />
            </linearGradient>
            <linearGradient id="roof" x1="180" y1="20" x2="180" y2="140" gradientUnits="userSpaceOnUse">
              <stop stop-color="var(--accent)" />
              <stop offset="1" stop-color="var(--accent-2)" />
            </linearGradient>
          </defs>
          <ellipse cx="180" cy="272" rx="132" ry="16" fill="var(--accent)" opacity=".1" />
          <path d="M180 34 42 140h24v112h228V140h24L180 34Z" fill="url(#wall)" stroke="var(--accent)" stroke-opacity=".45" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M180 20 28 143h304L180 20Z" fill="url(#roof)" opacity=".9" />
          <path d="M28 143h304" stroke="var(--accent-2)" stroke-width="3" stroke-linecap="round" />
          <rect x="150" y="180" width="60" height="72" rx="6" fill="var(--surface)" stroke="var(--accent)" stroke-opacity=".6" stroke-width="2.5" />
          <path d="M180 180v72M150 216h60" stroke="var(--accent)" stroke-opacity=".45" stroke-width="2" />
          <rect x="72" y="170" width="48" height="42" rx="6" fill="var(--accent-2)" opacity=".18" stroke="var(--accent-2)" stroke-width="2.5" />
          <rect x="240" y="170" width="48" height="42" rx="6" fill="var(--accent)" opacity=".16" stroke="var(--accent)" stroke-width="2.5" />
          <path d="M96 170v42M72 191h48M264 170v42M240 191h48" stroke="var(--accent-2)" stroke-opacity=".5" stroke-width="1.8" />
          <path d="M312 44v22M301 55h22" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
          <path d="M46 62v14M39 69h14" stroke="var(--accent-2)" stroke-width="2.6" stroke-linecap="round" />
          <circle cx="324" cy="104" r="3.5" fill="var(--accent-2)" opacity=".7" />
          <circle cx="34" cy="106" r="3" fill="var(--accent)" opacity=".6" />
        </svg>
      </div>
    </div>
  </section>

  <section class="section rooms-section">
    <div class="container">
      <div class="section-head"><div><h2>作坊里有什么</h2><p>五个角落，随便逛</p></div></div>
      <div class="room-grid">
        {rooms.map((room) => (
          <a class="room" href={room.href}>
            <span class="room-icon" aria-hidden="true">{room.icon}</span>
            <span class="room-title">{room.title}</span>
            <span class="room-desc">{room.desc}</span>
            <span class="room-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section games-section">
    <div class="container">
      <div class="section-head">
        <div><h2>AI 小游戏</h2><p>用 AI 做的，点开就能玩</p></div>
        <a class="text-link" href="/games/">全部游戏 →</a>
      </div>
      <div class="mini-game-grid">
        {games.slice(0, 4).map((game) => (
          <a class="mini-game" href={`/games/${game.slug}/`}>
            <span class="mini-game-cover">
              {game.cover
                ? <img src={game.cover} alt={`${game.title} 截图`} loading="lazy" />
                : <span aria-hidden="true">{game.emoji}</span>}
            </span>
            <span class="mini-game-info">
              <b>{game.title}</b>
              <small>{game.tag}</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section prompts-section">
    <div class="container">
      <div class="section-head">
        <div><h2>AI 提示词库</h2><p>把要求说清楚，AI 才能给对东西</p></div>
        <a class="text-link" href="/prompts/">全部提示词 →</a>
      </div>
      <div class="prompt-preview-grid">
        {prompts.slice(0, 4).map((p) => (
          <a class="prompt-preview" href={`/prompts/#${p.id}`}>
            <span class="prompt-preview-cat">{p.category}</span>
            <b>{p.title}</b>
            <small>{p.desc}</small>
            <span class="prompt-preview-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div><h2>精选文章</h2><p>从基础原理到工程落地</p></div>
        <a class="text-link" href="/blog/">查看全部 →</a>
      </div>
      <div class="post-grid">{shown.map((post) => <PostCard post={post} />)}</div>
    </div>
  </section>

  <section class="section" style="padding-top: 8px;">
    <div class="container">
      <div class="section-head">
        <div><h2>最近更新</h2><p>最新的思考与记录</p></div>
        <a class="text-link" href="/archives/">全部归档 →</a>
      </div>
      <div class="row-list">
        {latest.map((post) => (
          <a class="row" href={`/blog/${post.id}/`}>
            <span class="row-date">{post.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="row-title">{post.data.title}</span>
            <span class="row-cat">{post.data.category}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 8px;">
    <div class="container">
      <div class="section-head"><div><h2>按分类浏览</h2><p>挑一个感兴趣的方向</p></div></div>
      <div class="tag-cloud">
        {categories.map((c) => (
          <a href={categoryUrl(c.name)}>{c.name}<small>{c.count}</small></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-inner { max-width: none; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); gap: 48px; align-items: center; }
  .hero-copy { max-width: 720px; }
  .hero-hint { margin: 16px 0 0; font-size: 12.5px; color: var(--muted); }
  .hero-hint kbd {
    display: inline-block; margin: 0 2px; padding: 2px 6px; border-radius: 5px;
    border: 1px solid var(--border); background: var(--surface-2);
    color: var(--text-soft); font-family: inherit; font-size: 11px;
  }
  .hero-hint .hint-win { display: none; }
  .hero-art { display: grid; place-items: center; }
  .hero-art svg { width: min(100%, 360px); height: auto; filter: drop-shadow(0 18px 40px color-mix(in srgb, var(--accent) 18%, transparent)); animation: float 7s ease-in-out infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
  @media (prefers-reduced-motion: reduce) { .hero-art svg { animation: none; } }

  .rooms-section { padding-bottom: 24px; }
  .room-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-top: 28px; }
  .room {
    position: relative; display: flex; flex-direction: column; gap: 4px;
    padding: 20px 20px 22px; min-height: 132px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .room:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); box-shadow: 0 16px 38px rgba(31, 41, 79, .1); }
  .room-icon { font-size: 26px; line-height: 1.2; }
  .room-title { font-size: 16px; font-weight: 700; margin-top: 6px; }
  .room-desc { font-size: 13px; color: var(--muted); }
  .room-arrow { position: absolute; top: 20px; right: 20px; color: var(--accent); font-weight: 700; opacity: .6; }

  .games-section { padding-top: 20px; padding-bottom: 56px; }
  .mini-game-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 28px; }
  .mini-game {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    box-shadow: var(--shadow); transition: transform .2s, border-color .2s;
  }
  .mini-game:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .mini-game-cover {
    height: 96px; display: grid; place-items: center; font-size: 40px; overflow: hidden;
    background: radial-gradient(120px 70px at 25% 25%, color-mix(in srgb, var(--accent) 22%, transparent), transparent),
                radial-gradient(120px 70px at 80% 80%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent),
                var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .mini-game-cover img { width: 100%; height: 100%; object-fit: cover; }
  .mini-game-info { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 14px; }
  .mini-game-info b { font-size: 14px; }
  .mini-game-info small { font-size: 11px; color: var(--accent); background: var(--accent-soft); padding: 2px 8px; border-radius: 999px; white-space: nowrap; }

  .prompts-section { padding-top: 8px; padding-bottom: 56px; }
  .prompt-preview-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 28px; }
  .prompt-preview {
    position: relative; display: flex; flex-direction: column; gap: 6px;
    padding: 18px 20px; min-height: 148px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    box-shadow: var(--shadow); transition: transform .2s, border-color .2s;
  }
  .prompt-preview:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .prompt-preview-cat {
    align-self: flex-start; padding: 2px 9px; border-radius: 999px;
    font-size: 11px; color: var(--accent); background: var(--accent-soft); font-weight: 600;
  }
  .prompt-preview b { font-size: 15px; margin-top: 4px; }
  .prompt-preview small { font-size: 12.5px; color: var(--muted); line-height: 1.6; flex: 1;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .prompt-preview-arrow { position: absolute; bottom: 16px; right: 18px; color: var(--accent); opacity: .7; }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 12px; }
    .hero-art { display: none; }
    .room-grid, .mini-game-grid, .prompt-preview-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .hero { padding: 56px 0 48px; }
    .hero h1 { font-size: clamp(36px, 10vw, 46px); }
    .hero-stats { gap: 24px; }
    .room, .mini-game { border-radius: 12px; }
  }
</style>
