---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { games } from '../../data/games';

export function getStaticPaths() {
  return games.map((g) => ({ params: { slug: g.slug }, props: { game: g } }));
}

const { game } = Astro.props;
---

<BaseLayout title={`${game.title} · 小游戏 · 小天的AI作坊`} description={game.desc}>
  <section class="section">
    <div class="container game-page">
      <div class="game-head">
        <a class="back-link" href="/games/">← 返回小游戏</a>
        <h1 class="game-heading"><span aria-hidden="true">{game.emoji}</span> {game.title}</h1>
        <button class="btn btn-ghost fullscreen-btn" id="fullscreen-btn">⛶ 全屏</button>
      </div>
      <p class="game-sub">{game.desc}</p>

      <div class:list={['game-frame-wrap', { 'is-square': (game.aspect || '').replace(/\s/g, '') === '1/1' }]} id="game-frame-wrap" style={`aspect-ratio: ${game.aspect || '4 / 3'}`}>
        <iframe
          class="game-frame"
          src={`/play/${game.slug}/index.html`}
          title={game.title}
          loading="lazy"
          allow="fullscreen; gamepad; autoplay"
        ></iframe>
      </div>
      <p class="game-tip">提示：游戏区域内点击或按方向键开始，全屏模式体验更佳。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .game-page { max-width: 960px; }
  .game-head {
    display: flex; align-items: center; gap: 16px; margin-top: 8px;
  }
  .back-link { color: var(--muted); font-size: 14px; white-space: nowrap; }
  .back-link:hover { color: var(--accent); }
  .game-heading { margin: 0; font-size: 26px; font-weight: 800; letter-spacing: -.02em; flex: 1; min-width: 0; }
  .fullscreen-btn { white-space: nowrap; cursor: pointer; }
  @media (max-width: 520px) {
    .game-head { flex-wrap: wrap; gap: 8px 12px; }
    .game-heading { font-size: 21px; flex: 1 1 auto; white-space: nowrap; }
    .back-link { flex: 1 1 100%; order: -1; }
  }
  .game-sub { color: var(--text-soft); font-size: 14.5px; margin: 10px 0 20px; }
  .game-frame-wrap {
    position: relative; border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--border); box-shadow: var(--shadow);
    background: var(--surface-2);
    aspect-ratio: 4 / 3;
    max-height: 700px;
  }
  .game-frame-wrap:fullscreen {
    aspect-ratio: auto; max-height: none; border-radius: 0; border: none;
  }
  .game-frame { width: 100%; height: 100%; border: 0; display: block; }
  /* 窄屏：方形棋盘（贪吃蛇/五子棋）给竖向更高的框，否则棋盘会被 1:1 压得很小 */
  @media (max-width: 720px) {
    .game-frame-wrap.is-square { aspect-ratio: 1 / 1.32 !important; }
  }
  .game-tip { color: var(--muted); font-size: 13px; margin-top: 14px; }
</style>

<script>
  const btn = document.getElementById('fullscreen-btn');
  const wrap = document.getElementById('game-frame-wrap');
  btn?.addEventListener('click', () => {
    if (document.fullscreenElement) {
      document.exitFullscreen();
    } else {
      wrap?.requestFullscreen?.();
    }
  });

  // 把站点主题透传给 iframe 里的游戏，避免游戏跟随系统而站点是手动切换的
  const iframe = document.querySelector<HTMLIFrameElement>('.game-frame');
  const pushTheme = () =>
    iframe?.contentWindow?.postMessage(
      { type: 'theme', theme: document.documentElement.dataset.theme || 'light' },
      '*'
    );
  iframe?.addEventListener('load', () => {
    pushTheme();
    // 让游戏直接接管键盘，否则用户先按空格会滚动页面
    iframe.contentWindow?.focus();
  });
  const prevSync = (window as any).__syncArt;
  (window as any).__syncArt = () => { prevSync?.(); pushTheme(); };
</script>
