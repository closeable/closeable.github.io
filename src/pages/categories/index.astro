---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, groupBy, categoryUrl } from '../../utils/posts';

const posts = await getAllPosts();
const categories = [...groupBy(posts, (p) => p.data.category).entries()]
  .map(([name, items]) => ({ name, count: items.length }))
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="分类 · Lumen" description="按分类浏览全部文章。">
  <div class="container">
    <div class="page-head"><h1>分类</h1><p>共 {categories.length} 个分类。</p></div>
    <div class="tag-cloud">
      {categories.map((c) => <a href={categoryUrl(c.name)}>{c.name}<small>{c.count}</small></a>)}
    </div>
  </div>
</BaseLayout>
