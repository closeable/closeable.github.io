---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, formatDate } from '../../utils/posts';
import { projects, topics, principles } from '../../data/startup';

const posts = await getAllPosts();
const notes = posts.filter((p) => p.data.category === '创业');

const statusClass = (s: string) => (s === '已发布' ? 'done' : s === '写作中' ? 'doing' : 'todo');
---

<BaseLayout
  title="创业专栏 · 小天的AI作坊"
  description="一个人用 AI 做产品、把它送上网、再看它有没有人用的全过程记录：在做的项目、待写的选题、已发布的复盘。只写做过的，不写爽文。"
>
  <div class="container startup">
    <div class="page-head">
      <h1>创业专栏</h1>
      <p>
        记录一个人用 AI 做产品、把它送上网、然后看它到底有没有人用的全过程。这里没有「月入十万」，
        只有做过的事、花掉的钱，和没做成的那部分。
      </p>
    </div>

    <ul class="principles">
      {principles.map((t) => <li>{t}</li>)}
    </ul>

    <div class="handbook-list">
      <a class="handbook" href="/startup/handbook/">
        <div class="handbook-body">
          <span class="handbook-tag">手册 01 · 10 章</span>
          <h2>AI 虚拟产品实战手册</h2>
          <p>从选品、对标、封面标题，到开店上架、数据复盘。每一步给判断标准，不给「月入十万」。</p>
        </div>
        <span class="handbook-arrow" aria-hidden="true">→</span>
      </a>

      <a class="handbook" href="/startup/plugin-handbook/">
        <div class="handbook-body">
          <span class="handbook-tag">手册 02 · 10 章</span>
          <h2>Chrome 插件实战手册</h2>
          <p>用 AI 写一个浏览器插件并上架收费：选需求、搭骨架、过审核、定价、止损，附六个真实案例拆解。</p>
        </div>
        <span class="handbook-arrow" aria-hidden="true">→</span>
      </a>

      <a class="handbook" href="/startup/geo-handbook/">
        <div class="handbook-body">
          <span class="handbook-tag">手册 03 · 10 章</span>
          <h2>GEO 获客实战手册</h2>
          <p>让 AI 在被问到「哪家好」时说得出你：事实台账、内容写法、信源投放、五层验证与止损节奏。</p>
        </div>
        <span class="handbook-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <section class="block">
      <h2 class="block-title">在做的项目</h2>
      <div class="project-grid">
        {projects.map((p) => (
          <article class="project">
            <div class="project-top">
              <h3>{p.name}</h3>
              <span class="badge badge-live">{p.status}</span>
            </div>
            <p class="project-desc">{p.desc}</p>
            <div class="progress">
              <div class="progress-bar"><span style={`width:${p.progress}%`}></span></div>
              <span class="progress-num">{p.progress}%</span>
            </div>
            <p class="project-note">{p.note}</p>
            <div class="project-foot">
              <div class="tag-list">{p.stack.map((s) => <span class="tag">{s}</span>)}</div>
              <span class="project-updated">更新于 {p.updated}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="block">
      <h2 class="block-title">选题计划</h2>
      <p class="block-sub">写到哪一步就标到哪一步，不放空标题吊胃口。</p>
      <ol class="topic-list">
        {topics.map((t, i) => (
          <li class="topic">
            <span class="topic-idx">{String(i + 1).padStart(2, '0')}</span>
            <div class="topic-body">
              <div class="topic-head">
                <b>{t.title}</b>
                <span class={`badge badge-${statusClass(t.status)}`}>{t.status}</span>
              </div>
              <small>{t.desc}</small>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block">
      <h2 class="block-title">已发布的创业手记</h2>
      {notes.length > 0 ? (
        <div class="note-list">
          {notes.map((p) => (
            <a class="note" href={`/blog/${p.id}/`}>
              <span class="note-date">{formatDate(p.data.pubDate)}</span>
              <span class="note-title">{p.data.title}</span>
              <span class="note-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-note">还没有发布。第一篇正在写，写完会出现在这里。</p>
      )}
    </section>

    <p class="outro">
      想看哪个方向、或者想让某个具体问题挖深一点，在<a href="/about/">关于页</a>加微信说一声。
    </p>
  </div>
</BaseLayout>

<style>
  .startup { padding-bottom: 64px; }

  /* 正文限宽，避免宽屏下一行拉太长不好读 */
  .page-head p { max-width: 700px; }
  .principles {
    list-style: none; margin: 26px 0 0; padding: 18px 22px;
    max-width: 860px;
    background: var(--surface-2); border: 1px solid var(--border);
    border-radius: var(--radius); display: grid; gap: 9px;
  }
  .principles li {
    position: relative; padding-left: 18px;
    font-size: 13.5px; color: var(--text-soft); line-height: 1.7;
  }
  .principles li::before {
    content: ''; position: absolute; left: 0; top: .62em;
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
  }

  /* 手册入口卡 */
  .handbook-list {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px; margin-top: 18px;
  }
  .handbook {
    display: flex; align-items: center; gap: 18px;
    padding: 22px 24px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); text-decoration: none;
    box-shadow: var(--shadow);
    transition: border-color .2s, transform .2s;
  }
  .handbook:hover { border-color: var(--accent); transform: translateY(-1px); }
  .handbook-body { min-width: 0; }
  .handbook-tag {
    font-size: 11px; font-weight: 700; letter-spacing: .07em;
    color: var(--accent); text-transform: uppercase;
  }
  .handbook h2 { font-size: 17px; margin-top: 7px; color: var(--text); }
  .handbook p {
    margin-top: 7px; font-size: 13.5px; line-height: 1.75;
    color: var(--text-soft); max-width: 640px;
  }
  .handbook-arrow {
    margin-left: auto; flex-shrink: 0;
    font-size: 20px; color: var(--accent);
  }

  .block { margin-top: 52px; }  .block-title { font-size: 20px; letter-spacing: .01em; }
  .block-sub { margin-top: 6px; font-size: 13px; color: var(--muted); }

  .project-grid { display: grid; gap: 18px; margin-top: 20px; }
  .project {
    position: relative; overflow: hidden;
    padding: 26px 28px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .project::before {
    content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }
  .project-top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .project-top h3 { font-size: 18px; }
  .project-desc { margin-top: 12px; font-size: 14px; line-height: 1.8; color: var(--text-soft); max-width: 820px; }

  .progress { display: flex; align-items: center; gap: 12px; margin-top: 18px; }
  .progress-bar { flex: 0 1 320px; max-width: 320px; height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .progress-bar span {
    display: block; height: 100%; border-radius: 999px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
  }
  .progress-num { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }

  .project-note {
    margin-top: 16px; padding-left: 13px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 42%, transparent);
    font-size: 13px; line-height: 1.75; color: var(--muted);
  }
  .project-foot {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; margin-top: 18px; flex-wrap: wrap;
  }
  .project-updated { font-size: 12px; color: var(--muted); }

  .badge { padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600; white-space: nowrap; }
  .badge-live { color: var(--accent); background: var(--accent-soft); }
  .badge-done { color: #10b981; background: color-mix(in srgb, #10b981 16%, transparent); }
  .badge-doing { color: #f59e0b; background: color-mix(in srgb, #f59e0b 16%, transparent); }
  .badge-todo { color: var(--muted); background: var(--surface-2); }

  .topic-list { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 2px; }
  .topic {
    display: flex; gap: 16px; padding: 16px 18px;
    border: 1px solid transparent; border-radius: 12px;
    transition: background .2s, border-color .2s;
  }
  .topic:hover { background: var(--surface); border-color: var(--border); }
  .topic-idx {
    font-size: 12px; color: var(--muted); padding-top: 3px;
    font-variant-numeric: tabular-nums;
  }
  .topic-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .topic-head b { font-size: 15px; line-height: 1.5; }
  .topic-body small { display: block; margin-top: 5px; font-size: 12.5px; line-height: 1.7; color: var(--muted); }

  .note-list { display: grid; gap: 2px; margin-top: 18px; }
  .note {
    display: grid; grid-template-columns: 92px 1fr auto; align-items: center; gap: 14px;
    padding: 14px 18px; border-radius: 12px; text-decoration: none;
    border: 1px solid transparent; transition: background .2s, border-color .2s;
  }
  .note:hover { background: var(--surface); border-color: var(--border); }
  .note-date { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .note-title { font-size: 14.5px; color: var(--text); font-weight: 600; }
  .note-arrow { color: var(--accent); }

  .empty-note {
    margin-top: 18px; padding: 26px;
    border: 1px dashed var(--border); border-radius: var(--radius);
    font-size: 13.5px; color: var(--muted); text-align: center;
  }

  .outro {
    margin-top: 58px; padding-top: 22px;
    border-top: 1px solid var(--border);
    font-size: 13.5px; color: var(--muted); line-height: 1.8;
  }
  .outro a { color: var(--accent); }

  @media (max-width: 860px) {
    .handbook-list { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .handbook { padding: 18px 20px; gap: 14px; }
    .handbook-arrow { display: none; }
    .project { padding: 22px 20px; }
    .topic { padding: 14px 10px; gap: 12px; }
    .note { grid-template-columns: 1fr auto; }
    .note-date { display: none; }
    /* 小屏：标题独占一行，徽章落到下面，避免和编号错位 */
    .topic-head b { display: block; }
    .topic-head .badge { margin-top: 7px; }
    .progress-bar { flex: 1 1 auto; max-width: none; }
  }
</style>
