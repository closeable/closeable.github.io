<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#toc-nav a'));
  const secs = Array.from(document.querySelectorAll<HTMLElement>('.hb-sec'));
  if (links.length && secs.length) {
    let ticking = false;
    const update = () => {
      let current = secs[0];
      for (const s of secs) {
        if (s.getBoundingClientRect().top <= 150) current = s;
      }
      links.forEach((a) => a.classList.toggle('active', a.dataset.target === current.id));
      ticking = false;
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }

  const mobileToc = document.querySelector<HTMLDetailsElement>('.hb-toc-mobile');
  mobileToc?.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
    a.addEventListener('click', (ev) => {
      const id = a.getAttribute('href')?.replace('#', '');
      const el = id ? document.getElementById(id) : null;
      if (!el) return;
      ev.preventDefault();
      mobileToc.open = false;
      window.setTimeout(() => {
        const y = Math.max(el.getBoundingClientRect().top + window.scrollY - 96, 0);
        const root = document.documentElement;
        const prev = root.style.scrollBehavior;
        root.style.scrollBehavior = 'auto';
        window.scrollTo(0, y);
        root.style.scrollBehavior = prev;
        history.replaceState(null, '', `#${id}`);
      }, 60);
    });
  });
</script>
