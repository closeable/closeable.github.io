---
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * 创业手册：AI 虚拟产品（小红书方向）
 * 说明：结构与方法整理自 AI 破局俱乐部《AI 小红书虚拟产品实战手册》（2026-09 行动营），
 * 本站为提炼重写，不是原文转载。平台规则会变，具体操作以官方为准。
 */

const toc = [
  { id: 'overview', n: '00', title: '一页速览' },
  { id: 'what', n: '01', title: '这门生意是什么' },
  { id: 'prepare', n: '02', title: '账号与前置准备' },
  { id: 'pick', n: '03', title: '选品：定生死的一步' },
  { id: 'benchmark', n: '04', title: '对标：看别人怎么卖' },
  { id: 'content', n: '05', title: '内容：封面、标题、内页' },
  { id: 'store', n: '06', title: '开店与商品页' },
  { id: 'build', n: '07', title: '把产品做出来' },
  { id: 'data', n: '08', title: '数据与止损' },
  { id: 'legal', n: '09', title: '版权与合规' },
];
---

<BaseLayout
  title="AI 虚拟产品实战手册 · 创业专栏 · 小天的AI作坊"
  description="从选品、对标、内容、开店到数据复盘的完整流程：10 个章节，每一步都给判断标准和可执行动作。整理自 AI 破局俱乐部行动营手册，本站为提炼重写版。"
>
  <div class="container hb">
    <div class="page-head">
      <p class="hb-kicker">创业手册 · 2026 年 11 月整理</p>
      <h1>AI 虚拟产品实战手册</h1>
      <p>
        在小红书卖虚拟资料这件事，从选品到出第一单，其实是一条固定的流水线：
        找人要什么 → 做出来 → 挂上货架 → 用笔记把人引过去 → 看数据改。
        这份手册把它拆成 10 章，每一章都给判断标准和能直接照做的动作。
      </p>
      <p class="hb-source">
        内容整理自 AI 破局俱乐部《AI 小红书虚拟产品》行动营手册（2026 年 9 月版），
        按自己的理解重新组织与重写，不是原文转载。平台规则常变，涉及类目、保证金、审核的部分以官方页面为准。
      </p>
    </div>

    <div class="hb-layout">
      <!-- 桌面端目录 -->
      <aside class="hb-toc" aria-label="手册目录">
        <div class="toc-head">目录</div>
        <nav id="toc-nav">
          {toc.map((t) => (
            <a href={`#${t.id}`} data-target={t.id}>
              <span class="toc-n">{t.n}</span>
              <span>{t.title}</span>
            </a>
          ))}
        </nav>
      </aside>

      <div class="hb-main">
        <!-- 移动端目录 -->
        <details class="hb-toc-mobile">
          <summary>目录 · 共 {toc.length} 章</summary>
          <nav>
            {toc.map((t) => (
              <a href={`#${t.id}`}><span class="toc-n">{t.n}</span>{t.title}</a>
            ))}
          </nav>
        </details>

        <!-- 00 -->
        <section id="overview" class="hb-sec">
          <h2><span class="sec-n">00</span>一页速览</h2>
          <p class="sec-lead">先看全貌，再决定要不要花这两周。</p>

          <div class="flow">
            {[
              ['01', '选品', '找一个真实有人搜、你做得出来的品'],
              ['02', '备号', '账号满 30 天、养 3 天、测一次流量'],
              ['03', '做品', '最小可用版本，别追求完美'],
              ['04', '上架', '个人售卖或开店铺，配好自动发货'],
              ['05', '发笔记', '封面标题决定生死，商品笔记占大头'],
              ['06', '看数据', '曝光、点击、成交，三段分开判断'],
            ].map(([n, t, d]) => (
              <div class="flow-item">
                <span class="flow-n">{n}</span>
                <b>{t}</b>
                <small>{d}</small>
              </div>
            ))}
          </div>

          <h3>时间怎么分配</h3>
          <table>
            <thead>
              <tr><th>阶段</th><th>大概花多久</th><th>产出</th></tr>
            </thead>
            <tbody>
              <tr><td>第 1 周</td><td>每天 1–2 小时</td><td>账号可用 + 3 个候选品 + 对标表</td></tr>
              <tr><td>第 2 周</td><td>2–3 个整天</td><td>产品雏形 + 商品上架（能下单）</td></tr>
              <tr><td>第 3–4 周</td><td>每天 1–2 小时</td><td>10–15 篇笔记，跑出第一单</td></tr>
              <tr><td>第 5 周起</td><td>按数据决定</td><td>决定加码还是换品</td></tr>
            </tbody>
          </table>

          <h3>钱花在哪</h3>
          <ul>
            <li><b>保证金</b>：电子资源类目通常要先缴一笔（历史上约 1000 元），关店可退，不是成本，是押金。</li>
            <li><b>工具</b>：设计工具用免费额度就够；查违禁词的网站免费。</li>
            <li><b>投流</b>：第一单出来之前不建议花钱。自然流量跑不动的时候投流只会放大问题。</li>
            <li><b>真正的成本是时间</b>：做品两三天，写笔记是长期的活。</li>
          </ul>

          <div class="callout callout-warn">
            <b>先把预期放平</b>
            <p>这不是「上架就出单」的生意。第一件产品大概率卖不动，它的价值是让你把整条流程走通一遍——知道哪一步会卡、卡在什么地方。抱着「第一款必须赚」的心态，通常三周就放弃了。</p>
          </div>
        </section>

        <!-- 01 -->
        <section id="what" class="hb-sec">
          <h2><span class="sec-n">01</span>这门生意是什么</h2>
          <p class="sec-lead">理解结构，比记住操作步骤重要。</p>

          <h3>虚拟产品指什么</h3>
          <p>没有实物、不用发货、在线交付的都算。常见的四类：</p>
          <ul>
            <li><b>资料型</b>：备考笔记、行业避坑指南、题库、话术库</li>
            <li><b>模板型</b>：PPT / Excel / 简历 / Notion / 飞书模板</li>
            <li><b>工具型</b>：测试链接、小工具网页、在线计算器</li>
            <li><b>知识库型</b>：整理成体系的文档库，按目录查阅</li>
          </ul>

          <h3>商业闭环</h3>
          <p>五个环节，任何一环断了都不出单：</p>
          <ol>
            <li><b>需求</b>：有人在搜、在评论里问，不是你觉得有用</li>
            <li><b>产品</b>：做出来能直接用的东西，不是一堆散文件</li>
            <li><b>笔记</b>：封面让人停、标题让人点、内页让人信</li>
            <li><b>商品页</b>：目录、样张、交付说明，把犹豫的人推过线</li>
            <li><b>交付</b>：自动发货，不用你守着回消息</li>
          </ol>

          <h3>为什么是小红书</h3>
          <ul>
            <li><b>搜索有长尾</b>：半年前发的笔记，关键词布局对了，现在还会有人搜到下单。这一点和短视频平台完全不同。</li>
            <li><b>用户决策成本低</b>：一份几十块的资料，对目标人群来说不构成决策负担，很少砍价。</li>
            <li><b>不用露脸</b>：图文为主，手机加电脑就能做。</li>
            <li><b>售后极轻</b>：标准化的东西，几乎没有退换。</li>
          </ul>

          <h3>三个必须提前接受的现实</h3>
          <div class="callout">
            <p><b>一、品有周期。</b>开学第一课这类品，过了开学就没人买；AI 工具指南这类，热度可能只有两三个月。看到好品，当期就跟，别等。</p>
            <p><b>二、平台在收紧。</b>「打包几百个模板就能卖」的时代已经过去了，现在查侵权、查搬运。越是省事的做法，越容易被封。</p>
            <p><b>三、收入不等于利润。</b>销售额里要扣平台佣金、退款、投流、买对标的钱。算清楚再谈赚多少。</p>
          </div>
        </section>

        <!-- 02 -->
        <section id="prepare" class="hb-sec">
          <h2><span class="sec-n">02</span>账号与前置准备</h2>
          <p class="sec-lead">这一步最枯燥，但账号带病，后面全是白费。</p>

          <h3>设备与网络</h3>
          <ul>
            <li>一机一卡一号。闲置手机清空就能用，不必买新的；不要用工作室淘汰的二手机。</li>
            <li>手机卡走三大运营商正规渠道：官方 App、营业厅，或电商平台咨询客服办低价卡。</li>
            <li>不要用模拟器、云手机、多开分身注册，也不要在一台机器上频繁切号。</li>
            <li>建议用移动流量操作，避免同一 WiFi 下别的号出问题牵连到你。</li>
          </ul>

          <h3>账号门槛</h3>
          <p>注册满 30 天、没有严重违规、没有功能限制就能用。新号老号都行，老号要先做一次体检：</p>
          <p class="path">我 → 左上角「≡」→ 创作者中心 → 全部服务 → 账号诊断</p>
          <p>检测有提示就按提示处理；没问题的号继续下一步。</p>

          <h3>养号三天</h3>
          <p>新号是审核最严的时候，平台要先确认你是真人，不是营销矩阵。做法很简单——像正常人一样刷三天：</p>
          <ul>
            <li>首页往下刷，感兴趣的进去看完，图文滑到底，视频别秒退</li>
            <li>偶尔点赞、收藏、评论，别机械地每篇都互动</li>
            <li>顺手刷对标账号，顺便就把市场看了一遍</li>
          </ul>
          <p><b>这三天不要做的四件事</b>：不要急着改头像简介；不要发笔记；不要在任何地方留微信、二维码；不要急着实名（未实名不影响流量）。</p>

          <h3>测一次流量</h3>
          <p>养号之后发一篇互动笔记（纯话题讨论，不带商品），24 小时内小眼睛能到 200 以上，说明账号健康。没到也别立刻判死刑——单篇没跑起来很正常，连着十几篇都不行，再考虑是不是号的问题。</p>
          <p>互动笔记还有两个用处：把很久没用的老号、刚解封的号活跃度拉起来；以及花两天测一个想法的真实需求，比闷头做两周产品划算。</p>

          <h3>账号四件套</h3>
          <p>昵称、头像、简介、背景图。原则是<b>专业、垂直、有人味</b>，不要像个自动发货机器人。</p>
          <ul>
            <li><b>昵称</b>：体现你提供什么。带品类词更容易被搜到。</li>
            <li><b>头像</b>：真人精修、风格化插画、极简字标都行，画质必须清晰。</li>
            <li><b>简介</b>：你是谁 + 提供什么。绝对不能写引流信息，这是最常见的违规点。</li>
            <li><b>背景图</b>：默认的也能用，要换就换和定位一致的。</li>
          </ul>
          <div class="callout callout-tip">
            <b>顺序很重要</b>
            <p>先定选品，再改四件套。反过来做，选品一变，四件套全要重来，而且频繁改资料本身就是可疑行为。</p>
          </div>
        </section>

        <!-- 03 -->
        <section id="pick" class="hb-sec">
          <h2><span class="sec-n">03</span>选品：定生死的一步</h2>
          <p class="sec-lead">选错了，后面所有努力都是在给一个没人要的东西做包装。</p>

          <h3>两条腿走路</h3>
          <p><b>看市场</b>：这个需求真实存在吗？有人搜、有人问、有人已经在卖并且卖得动。</p>
          <p><b>看自己</b>：四个自检——</p>
          <ul>
            <li><b>懂不懂</b>：完全不懂的领域，笔记写不出细节，客服也答不上来</li>
            <li><b>做不做得出来</b>：新手期选制作难度低的，先跑通再优化</li>
            <li><b>好不好交付</b>：开箱即用、不用答疑，才能真的省下人力</li>
            <li><b>好不好写笔记</b>：如果对标全是视频而你不会拍，这个品对你就很难</li>
          </ul>

          <h3>四个找品入口</h3>
          <ol>
            <li><b>站内搜索</b>：首页搜索框搜的是笔记，底部「市集」搜的是商品。宽泛词（虚拟资料、电子模板）看大盘，精准词（如「小学生开学第一课 PPT」）看具体品。</li>
            <li><b>评论区</b>：搜赛道关键词，翻高赞高评论的笔记，找三种信号——直接求购（「哪里买」「求链接」）、延伸需求（「有没有 XX 版本的」「想要可编辑的」）、痛点共鸣（「太需要了」）。这是蓝海需求最集中的地方。</li>
            <li><b>下拉词延伸</b>：输入一个人群或场景词，看下拉出来的长尾词。每个下拉词背后都是一群正在找答案的人。点进去再用「最新」排序看近两周的互动。</li>
            <li><b>千帆后台</b>：有店铺权限后，在笔记中心能看到「相似商家也在发笔记」，直接看同行在推什么。</li>
          </ol>

          <h3>判断一个品能不能跟</h3>
          <p>三个信号同时看，缺一个都别急：</p>
          <table>
            <thead>
              <tr><th>看什么</th><th>怎么判断</th><th>不成立的意思</th></tr>
            </thead>
            <tbody>
              <tr><td>需求还在不在</td><td>切「最新」排序，近 1–2 周笔记还有几十到几百互动</td><td>只有老笔记有数据，说明热度过了</td></tr>
              <tr><td>卖得动不动</td><td>商品页有近 24 小时 / 一周 / 一月的销量标签</td><td>累计销量高但近期没动静，是过去式</td></tr>
              <tr><td>竞争挤不挤</td><td>搜同一个词，第一屏是否已被大店占满</td><td>前几屏全是几千粉的店，新手很难挤进去</td></tr>
            </tbody>
          </table>

          <h3>别踩的四条线</h3>
          <ul>
            <li><b>有明确版权归属的</b>：畅销书扫描版、付费课程录播、知名 IP 的素材</li>
            <li><b>带机构标识的</b>：印着学校、培训机构、出版社 logo 和水印的资料</li>
            <li><b>有版权声明的</b>：写明「未经许可不得复制传播销售」的资源</li>
            <li><b>来源说不清的</b>：AI 生成的内容也要查——模型吐出来的图，可能本身就带着别人的版权</li>
          </ul>
          <div class="callout callout-warn">
            <p>版权问题不是「赚多赚少」，是「账号还在不在」。轻则笔记下架、商品删除，重则店封、保证金扣。利润再高也别碰。</p>
          </div>

          <h3>关于心态</h3>
          <p>最常见的情况是：刷到教辅想做教辅，刷到育儿觉得也不错，一个月过去还在选品。第一款产品的目标不是赚钱，是把「发现需求 → 做产品 → 发笔记 → 上架 → 拿到反馈」完整走一遍。走通一次，第二款会快很多。</p>
          <p>能不能同时测几个品？可以，但别超过 2–3 个方向，各发几篇笔记，谁反馈好就集中做谁。同时铺五个，等于五个都没做透。</p>
        </section>

        <!-- 04 -->
        <section id="benchmark" class="hb-sec">
          <h2><span class="sec-n">04</span>对标：看别人怎么卖</h2>
          <p class="sec-lead">只看封面会做出一篇像样的笔记，但你不知道它怎么接到商品上。</p>

          <h3>三层对标</h3>
          <table>
            <thead>
              <tr><th>层</th><th>看什么</th><th>回答的问题</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><b>账号</b></td>
                <td>简介、店铺、更新频率、早期内容方向</td>
                <td>这门生意他是怎么做的？卖给谁？</td>
              </tr>
              <tr>
                <td><b>笔记</b></td>
                <td>封面、完整标题、开头两句、结构、结尾动作</td>
                <td>为什么有人愿意点进来、看下去？</td>
              </tr>
              <tr>
                <td><b>商品</b></td>
                <td>规格、到手价、单品销量、目录、试读、交付与售后说明</td>
                <td>用户凭什么下单？</td>
              </tr>
            </tbody>
          </table>
          <p>挑笔记的时候不要只存最高赞那篇。每个账号看三篇：一篇互动高的、一篇近期的、一篇表现普通的。对比之后才知道哪些是账号一直在用的套路，哪些只是某篇偶然撞上的。</p>

          <h3>怎么搜</h3>
          <p>先列词再搜，分三组：</p>
          <ul>
            <li><b>产品词</b>：社会化指南、话术库、沟通手册（找卖家，了解货架）</li>
            <li><b>人群词</b>：i 人、内向女生、职场新人、不善表达（找人群，了解谁在买）</li>
            <li><b>场景词</b>：不会拒绝同事、跟领导聊天、亲戚问工资（找内容，了解他们为什么买）</li>
          </ul>
          <p>产品词帮你看到「有什么在卖」，场景词帮你看到「用户到底卡在哪」。后者才是写笔记的素材来源。</p>
          <p>另外两条路：顺着爆款笔记带的话题找同类账号；从已找到的账号的主页推荐、相关账号继续扩展。每加一个候选，都回店铺核对一遍——平台推「相似」，不代表商业模式相同。</p>

          <h3>筛掉不合格的对标</h3>
          <ol>
            <li><b>还在做吗</b>：最近有没有更新，商品还在不在，有没有近期评价。累计销量高但半年没动静，只能证明过去好卖。</li>
            <li><b>结果是不是这个产品带来的</b>：单品销量、店铺销量、笔记互动是三件事。收藏多只说明内容值得存，不能当购买意向。</li>
            <li><b>我做得出来吗</b>：对方的优势如果来自多年经验、独家资源或一对一服务，你照着做不出来。</li>
            <li><b>找得到具体改进吗</b>：能落到「目录按场景重排」「每节加一段对话」「加搜素索引」，才叫可借鉴。「我也做一本更全的」不算。</li>
          </ol>

          <h3>记成一张表</h3>
          <p>一个账号一行，先记事实，再写判断：</p>
          <table>
            <thead>
              <tr><th>字段</th><th>内容</th></tr>
            </thead>
            <tbody>
              <tr><td>基础</td><td>采集日期、账号名、主页链接、粉丝数、最近更新时间</td></tr>
              <tr><td>商品</td><td>商品链接、当前规格与价格、单品累计销量、交付形式</td></tr>
              <tr><td>内容</td><td>3 篇笔记的标题、日期、互动、讲什么场景、结尾怎么承接</td></tr>
              <tr><td>判断</td><td>值得学的一点、没核实的地方、我准备怎么做</td></tr>
            </tbody>
          </table>
          <p>评论区也要记，但要分开：「哪里买」接近购买，「怎么用」接近使用，「我也有这困扰」只是共鸣。三种不能混着当购买意向。没看到评论就写「未观察到」，不要替用户编需求。</p>
          <div class="callout callout-tip">
            <b>这一轮什么时候算完</b>
            <p>能说清 3 个对标各自卖给谁、怎么展示产品、你准备借鉴哪一点。说不清就别急着批量写笔记。</p>
          </div>
        </section>

        <!-- 05 -->
        <section id="content" class="hb-sec">
          <h2><span class="sec-n">05</span>内容：封面、标题、内页</h2>
          <p class="sec-lead">一篇笔记的质量，主要由封面点击率决定。新手常把时间全花在正文上，这是找错了重点。</p>

          <h3>笔记的组成</h3>
          <p>封面、内页（3–6 张）、标题、正文、话题标签、评论区。推荐流里只有封面和标题同时出现，所以这两样决定有没有人进来。</p>

          <h3>四种封面</h3>
          <table>
            <thead>
              <tr><th>类型</th><th>特点</th><th>适合</th></tr>
            </thead>
            <tbody>
              <tr><td><b>大字报</b></td><td>字大、话短、冲击强，一秒判断「跟我有没有关系」</td><td>情绪型、测试型、观点型笔记</td></tr>
              <tr><td><b>实拍</b></td><td>真实、有场景感，能快速说明一个复杂产品</td><td>模板、手账、资料包、桌面工具</td></tr>
              <tr><td><b>截图</b></td><td>直接把产品摊开：目录、题库、结果页</td><td>资料型，最省力也最可信</td></tr>
              <tr><td><b>干货拼图</b></td><td>信息密度高，让人觉得「存下来有用」</td><td>清单、思维导图、合集</td></tr>
            </tbody>
          </table>
          <p>大字报用小红书自带的「写文字」就能做；实拍拿手机对着屏幕拍，注意别反光；拼图用美图秀秀；思维导图用 ProcessOn。工具不重要，字够大、看得清才重要。</p>

          <h3>标题怎么写</h3>
          <p><b>四个零件</b>：人群（谁要看）+ 痛点或结果（解决什么）+ 数字（具体、可信）+ 关键词（能被搜到）。不用全占，有两三个就够。</p>
          <p><b>六个方向</b>，各给一个例子：</p>
          <ul>
            <li><b>人群 + 痛点 + 结果</b>：二本应届生｜简历改到这 5 处，面试电话多了起来</li>
            <li><b>数字清单</b>：整理了 36 个 Excel 常用模板，改个数字就能用</li>
            <li><b>避坑</b>：买虚拟资料前先看这篇，5 个坑我都踩过</li>
            <li><b>对比</b>：同样是 9.9 的资料包，为什么有人一天出 30 单</li>
            <li><b>疑问</b>：为什么你的笔记没人看？九成卡在封面这一步</li>
            <li><b>场景</b>：期末周救星｜这套复习清单让我少熬两个通宵</li>
          </ul>
          <p><b>四步写</b>：① 搜核心词，记下拉词和相关搜索；② 把最关键的词放进前 18 个字（手机端大约只显示这么多）；③ 加数字和结果；④ 过一遍违禁词检测。</p>
          <p><b>长度</b>：20 字以内最舒服，用「｜」或「，」断成两段，前段放关键词，后段放钩子。</p>
          <div class="callout callout-warn">
            <b>限流词别碰</b>
            <p>极限词（最、第一、绝对、100%）、诱导词（点击领取、私信我、免费送、加微信）、过度承诺（保证赚钱、月入过万）。轻则限流，重则违规。</p>
          </div>

          <h3>内页怎么做</h3>
          <p>内页的任务是接住封面许下的承诺，把价值说清楚，最后把人送到商品页。5 张左右够用：</p>
          <ol>
            <li><b>全景</b>：一共多少份、多少页、覆盖什么范围，越具体越可信</li>
            <li><b>目录</b>：完整目录截图，这是虚拟资料最关键的转化点</li>
            <li><b>样张两到三张</b>：真实内容截图，证明不是空壳</li>
            <li><b>背书</b>：使用效果、买家反馈、聊天记录</li>
            <li><b>引导</b>：告诉用户去哪拿（主页、店铺、评论区）</li>
          </ol>
          <p><b>三条原则</b>：一图一信息，手机上能看清才算合格；风格统一，同色系同字体，统一 3:4 竖版；真实感比精致重要——文件夹截图、目录截图往往比精心设计的大海报更可信。用户买的是「里面有什么」，不是「你多会做图」。</p>

          <h3>正文</h3>
          <p>三个作用：补充封面没说完的、埋关键词让人搜到、给一个明确的下一步。</p>
          <ul>
            <li><b>开头两行</b>：接住标题，把痛点在具体场景里说一遍。「做 XX 最头疼的就是 XX，我之前也这样」</li>
            <li><b>中间</b>：分点讲包含什么、适合谁、怎么用。一段只讲一件事。</li>
            <li><b>结尾</b>：给动作但别太直白。「需要的看左下角」「完整版在下方」「评论区置顶」都比「私信我领」安全。</li>
          </ul>
          <p>核心词在正文里自然出现 3–5 次，分布在首段、中间、结尾，别硬堆。排版上多换行、短句、适当用符号分段——手机竖屏看到一大坨字，直接就划走了。</p>

          <h3>标签</h3>
          <p>三类各两三个：泛流量词（#职场 #效率）、精准长尾词（#简历模板 #面试自我介绍）、人群场景词（#应届生求职）。</p>
          <p>找词最省事的办法：搜核心词看下拉，再看同行爆款挂了什么。两条提醒：标签必须和内容真实相关，乱挂大词会被判不相关反而掉推荐；可以给自己建一个固定话题（账号名或栏目名），每篇都带，慢慢沉淀。</p>

          <h3>挂车与评论区</h3>
          <p>挂车两种方式：发笔记时「添加组件 → 商品 → 选择商品」；或者发完之后在评论区点加号，添加商品（蓝链）。</p>
          <p>评论区是第二个转化场。很多人笔记流量不错但没成交，问题不在内容，在评论区没接住。写的时候按这个顺序：</p>
          <ol>
            <li><b>过来人身份</b>：「我是 XX，以前也总在这件事上卡住」</li>
            <li><b>真实结果</b>：「后来自己整理出一套方法，慢慢顺了」</li>
            <li><b>顺势带出</b>：「为了少让人走弯路，我把它整理成了一份 XX，包含 XX」</li>
            <li><b>挂链接</b></li>
          </ol>
          <p>遇到「我有免费的」这类拆台评论，影响恶劣就直接删——你的评论区你做主。</p>

          <h3>发布前检查</h3>
          <ul>
            <li>封面在缩略图大小下还能看清字吗</li>
            <li>标题前 18 字有关键词吗</li>
            <li>全文过过违禁词检测吗</li>
            <li>标签和内容真的相关吗</li>
            <li>商品挂上了吗，点进去能看到吗</li>
          </ul>
        </section>

        <!-- 06 -->
        <section id="store" class="hb-sec">
          <h2><span class="sec-n">06</span>开店与商品页</h2>
          <p class="sec-lead">个人售卖和店铺是两条路，可以同时开，互不影响。</p>

          <h3>个人售卖 vs 店铺</h3>
          <table>
            <thead>
              <tr><th></th><th>个人售卖</th><th>店铺</th></tr>
            </thead>
            <tbody>
              <tr><td>门槛</td><td>账号满 30 天 + 实名</td><td>个人店只需身份证 + 实名号</td></tr>
              <tr><td>入口</td><td>小红书 App 内开通</td><td>千帆后台（网页或 App）</td></tr>
              <tr><td>上架类目</td><td>选「搞副业」，不能选「出闲置」</td><td>电子资源 / 其他模板类目</td></tr>
              <tr><td>适合</td><td>先试水，或开不了电子资源类目</td><td>长期做、要多 SKU 和营销工具</td></tr>
            </tbody>
          </table>
          <p>开不了「电子资源」类目的，直接走个人售卖，不用卡在类目上。个人售卖开通后要关联实名人的微信支付和支付宝，否则用户付不了款。</p>
          <p>店铺分三类：个人店（一张身份证，审核快，新手推荐）、个体店（要个体户执照，每季度报税）、企业店（公司执照，流程最重，没必要）。个人店改名免费且跟着账号名走；个体店和企业店改名要重新认证，一次 600。</p>

          <h3>商品主图</h3>
          <p>这是全店最重要的一张图，会出现在挂车笔记左下角和搜索结果里。要求：1:1 或 3:4，800×800 或 750×1000 以上，5M 以内。内容上让用户一眼看懂这是什么资料、给谁用、值在哪。</p>

          <h3>详情页六块</h3>
          <ol>
            <li><b>一句话是什么</b>：多少份、多少页、覆盖什么范围</li>
            <li><b>完整目录</b>：越具体越好，这是转化最关键的部分</li>
            <li><b>样张 3–5 张</b>：真实截图</li>
            <li><b>适合谁 / 不适合谁</b>：写清楚能明显减少误购和退款</li>
            <li><b>交付方式</b>：自动发货还是网盘链接，多久内到</li>
            <li><b>售后说明</b>：虚拟商品规则写明白</li>
          </ol>

          <h3>价格怎么定</h3>
          <ul>
            <li><b>有对标就跟</b>：先贴着同行定，再看自己的转化调</li>
            <li><b>尾数定价</b>：9.9、19.9、49.9 比整数显得划算</li>
            <li><b>套餐对比</b>：单份 9.9，两份套装 13.9，多 4 块拿双倍，套装更容易成</li>
            <li><b>阶梯涨价</b>：前 100 名 9.9，之后 19.9——数字必须真实</li>
            <li><b>低价试读 SKU</b>：0.99 / 1.99 的试读版，既能让用户先体验，也能在价格上跟同行争一点流量</li>
          </ul>

          <h3>上架时容易漏的几件事</h3>
          <ul>
            <li>物流模板必须建，即使无物流发货；地址填自己的，不影响</li>
            <li>发货模式选现货，自动发货链接只能填纯英文链接，有空格和中文会失败</li>
            <li><b>不要勾「七天无理由退货」</b>，虚拟资料不退不换</li>
            <li>上完架自己拍一单，走一遍全流程，确认能收到货</li>
            <li>配置店铺新人券：原价 38.8，券后 28.8，比直接标 28.8 转化好</li>
          </ul>

          <h3>数据在哪看</h3>
          <table>
            <thead>
              <tr><th>想知道什么</th><th>路径</th></tr>
            </thead>
            <tbody>
              <tr><td>哪篇笔记出单</td><td>千帆 App：数据 → 内容 → 选时间 → 笔记列表</td></tr>
              <tr><td>流量从哪来</td><td>千帆 App：数据 → 流量 → 流量来源</td></tr>
              <tr><td>单个商品的每篇笔记表现</td><td>PC 后台：数据 → 商品 → 商品列表 → 详情 → 内容分析</td></tr>
              <tr><td>蓝链订单</td><td>PC 后台：数据 → 笔记 → 笔记蓝链 → 来源分布</td></tr>
            </tbody>
          </table>

          <h3>用自动化换好评</h3>
          <p>下单后默认发一条消息，说明有赠品。智能客服里配好「用户说赠品 / 好评 → 回复让他选 1/2/3」，再给 1/2/3 各配一条自动回复。订单完成 + 用户回复，赠品自动发出去，好评率会明显好看，而且不用你守着。</p>
          <p class="path">千帆 → 客服 → 智能客服 → 店铺通用回复 → 自定义问答</p>

          <h3>保证金</h3>
          <p>电子资源类目一般要先缴一笔（历史上约 1000 元）才能上架。它不是成本，是押金：关店可退，超额缴纳的部分可以随时提现。个人店「0 元开店」指入驻不收费，但提现前或余额为负时仍需补缴。没缴保证金不能提现。</p>
        </section>

        <!-- 07 -->
        <section id="build" class="hb-sec">
          <h2><span class="sec-n">07</span>把产品做出来</h2>
          <p class="sec-lead">两条路：AI 直接生成一个网页产品，或者把别人做过的资料重新组织成自己的知识库。</p>

          <h3>路线 A：网页型产品</h3>
          <p>适合测试类、工具类。用户点开链接就能用，交付成本为零，还能做二次变现（免费结果 + 付费深度报告）。</p>
          <ol>
            <li><b>买一份对标的</b>（别用将来发笔记的号下单），走一遍它的流程，看结构：首页、题目页、结果页各解决什么</li>
            <li><b>让 AI 出内容</b>：把截图和自己的要求一起给模型——多少题、不要订单号验证、结果页要什么不要什么</li>
            <li><b>让 AI 出代码</b>：一句话就够，「把上面做成一个网页，生成单文件 HTML」</li>
            <li><b>部署拿链接</b>：贴进静态托管（GitHub Pages、Vercel、Netlify 都行），拿到 URL</li>
            <li><b>链接就是产品</b>：填进自动发货，用户下单即得</li>
          </ol>
          <div class="callout callout-tip">
            <b>这类品的优势</b>
            <p>制作快（熟手两小时）、单价低决策轻、结果页天然适合截图分享——用户会主动帮你传播。缺点是同质化快，所以要在题目质量和结果文案上下点功夫，别只是换个皮。</p>
          </div>

          <h3>路线 B：知识库型产品</h3>
          <p>适合把某个领域的经验整理成体系。价值不在字数，在于「用户遇到事，能马上找到那一节」。</p>
          <ol>
            <li><b>先买一份研究</b>：读目录、读两三节正文、看交付说明。先弄清结构，别一上来就让 AI 整本换个说法</li>
            <li><b>整理文件</b>：原始资料 / 目录 / 章节草稿 / 定稿 / 配图，五个文件夹分开，原文件别覆盖</li>
            <li><b>重做目录</b>：按真实使用场景排，不照搬原书章节。每节写清「一个场景 + 读完能做什么」</li>
            <li><b>一节一节写</b>：一次只给模型 1000–2000 字材料，写完核对再继续。先写一节定语气</li>
            <li><b>调成自己的话</b>：删套话、删空泛鼓励、删没有依据的「我带过很多学员」</li>
            <li><b>两轮检查</b>：先看内容对不对（话术在这关系里能用吗、有没有前后矛盾），再看能不能用（读者能否按场景找到、每节有没有一个可执行动作）</li>
            <li><b>排版</b>：飞书文档比 PDF 好——有目录能跳转、手机上读着舒服，也不那么容易被整包搬走</li>
          </ol>
          <div class="callout callout-warn">
            <b>二创的边界</b>
            <p>买一份资料，买到的是阅读权，不是转售权。改水印、换措辞、调低相似度，都不能替代授权。真正安全的做法是：只借用它的知识框架，内容自己重写、例子自己补、练习自己设计。要是整本只换了同义词，那还是搬运。</p>
          </div>

          <h3>先跑通最小闭环</h3>
          <p>第一次别想着做二十万字。一份目录 + 三节正文 + 一张速查表，就够上架测流量了。做完 20% 就上，卖得动再补。</p>
          <p>反过来想：做了一份完美但没人要的产品，也只是白费。先上架、去找选题、模仿同行账号，边卖边完善——这条顺序比「打磨到满意再上」有效得多。</p>
        </section>

        <!-- 08 -->
        <section id="data" class="hb-sec">
          <h2><span class="sec-n">08</span>数据与止损</h2>
          <p class="sec-lead">不出单的时候，最怕的是不知道卡在哪一层，然后乱改。</p>

          <h3>三层漏斗</h3>
          <table>
            <thead>
              <tr><th>层</th><th>指标</th><th>不行就改</th></tr>
            </thead>
            <tbody>
              <tr><td>曝光</td><td>小眼睛（阅读数）</td><td>账号权重、发布时间、标签、内容是否被判不相关</td></tr>
              <tr><td>点击</td><td>封面点击率</td><td>换封面、换标题。这是最该先动的一层</td></tr>
              <tr><td>成交</td><td>商品页访问 → 下单</td><td>详情页、价格、评价数、交付说明是否清楚</td></tr>
            </tbody>
          </table>
          <p>判断顺序永远是：先看曝光够不够，再看点击行不行，最后才怀疑商品页。曝光只有几十，谈转化没有意义；曝光几千但没人点，改商品页也没用。</p>

          <h3>笔记发了一周没出单</h3>
          <ol>
            <li>翻出这几篇的数据，看是「没曝光」还是「有曝光没点击」还是「有点击没成交」</li>
            <li>没曝光 → 换发布时间、补标签、检查有没有违禁词</li>
            <li>没点击 → 只改封面和标题，同一条内容重发一版对比</li>
            <li>有流量没成交 → 去商品页看：目录够不够具体、价格有没有对比、评价是不是零</li>
          </ol>
          <p>很多时候不是选品错了，是内容没接住。改内容比换品便宜。</p>

          <h3>什么时候该停</h3>
          <p>给自己定一个明确的止损线，比如：连续三周、发满 20 篇笔记、曝光正常但成交为零，就换品或者换人群。写下来，别靠感觉——不然很容易在「再发两篇看看」里耗掉两个月。</p>

          <h3>常见的死法</h3>
          <ul>
            <li><b>选品自嗨</b>：自己觉得有用，没人搜</li>
            <li><b>产品太重</b>：为了「值这个价」做了一大堆没人看的内容，拖到放弃</li>
            <li><b>笔记只发商品笔记</b>：全是硬广，没有干货和互动，账号权重起不来</li>
            <li><b>封面偷懒</b>：随手截个图就发，点进去的概率接近零</li>
            <li><b>频繁改定位</b>：半个月换三个方向，每个都没积累</li>
            <li><b>违规引流</b>：简介、评论、私信留微信，号直接被限</li>
          </ul>
        </section>

        <!-- 09 -->
        <section id="legal" class="hb-sec">
          <h2><span class="sec-n">09</span>版权与合规</h2>
          <p class="sec-lead">这一章没有技巧，只有底线。放在最后，但应该最先读。</p>

          <h3>三条不能碰的线</h3>
          <ul>
            <li><b>有明确版权归属的内容</b>：畅销书扫描版、教材电子版、付费课程录播、知名 IP 的衍生素材</li>
            <li><b>带机构标识的资料</b>：印着学校、机构、出版社 logo 或水印的，一律视为他人资产</li>
            <li><b>有版权声明的资源</b>：写明「未经许可不得复制、传播、销售」的，别碰</li>
          </ul>

          <h3>几个容易被忽略的点</h3>
          <ul>
            <li><b>购买 ≠ 授权</b>：买了一份资料，只获得自己阅读的权利</li>
            <li><b>改写 ≠ 原创</b>：换同义词、调顺序、改水印，法律上仍然是复制</li>
            <li><b>AI 生成 ≠ 无版权</b>：模型输出的图可能带着训练素材的影子，商用前要确认</li>
            <li><b>字体和配图也有版权</b>：商用设计别随便用网上下载的字体</li>
          </ul>

          <h3>平台侧的红线</h3>
          <ul>
            <li>类目要选对，电子资源类目有准入要求，达不到就走个人售卖</li>
            <li>笔记里不能有极限词、诱导词、收益承诺</li>
            <li>任何位置都不能出现微信号、二维码</li>
            <li>虚拟商品不支持七天无理由，别为了显得有底气去勾选</li>
          </ul>

          <div class="callout callout-warn">
            <p>违规的代价不是罚点钱，是账号归零——积累的粉丝、笔记、评价、店铺分全部作废。所以宁可做得慢一点，也别踩这条线。</p>
          </div>
        </section>

        <div class="hb-foot">
          <p>
            这份手册会跟着实操更新。另外两本：<a href="/startup/plugin-handbook/">Chrome 插件实战手册</a>讲怎么把工具做出来并上架，
            <a href="/startup/geo-handbook/">GEO 获客实战手册</a>讲客户改问 AI 之后怎么被推荐。想看实际下场的结果，回<a href="/startup/">创业专栏</a>。
          </p>
          <p class="hb-foot-note">
