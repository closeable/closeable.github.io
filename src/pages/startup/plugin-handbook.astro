  .callout p { margin-top: 8px; font-size: 13.5px; line-height: 1.85; }
  .callout p:first-of-type { margin-top: 0; }
  .callout-tip { border-left-color: var(--accent); background: var(--accent-soft); }
  .callout-warn { border-left-color: #f59e0b; background: color-mix(in srgb, #f59e0b 9%, transparent); }

  .hb-foot {
    margin-top: 64px; padding-top: 24px;
