---
---

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-backdrop" data-close></div>
  <div class="search-dialog" role="dialog" aria-modal="true" aria-label="全站搜索">
    <div class="search-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <input id="search-input" type="search" placeholder="搜索文章、游戏、提示词…" autocomplete="off" aria-label="搜索站点内容" />
      <button class="esc-btn" data-close aria-label="关闭搜索">Esc</button>
    </div>
    <div class="search-results" id="search-results" role="listbox"></div>
    <div class="search-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<style is:global>
  .search-overlay {
    position: fixed; inset: 0; z-index: 200;
    display: flex; align-items: flex-start; justify-content: center;
    padding: min(12vh, 100px) 20px 20px;
  }
  .search-overlay[hidden] { display: none; }
  .search-backdrop { position: absolute; inset: 0; background: rgba(10, 14, 26, .55); backdrop-filter: blur(3px); }
  .search-dialog {
    position: relative; width: min(620px, 100%); max-height: 74vh; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, .3); overflow: hidden;
  }
  .search-field { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--border); }
  .search-field svg { width: 20px; height: 20px; color: var(--muted); flex-shrink: 0; }
  .search-field input {
    flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
    color: var(--text); font-size: 16px;
  }
  .search-field input::placeholder { color: var(--muted); }
  .esc-btn {
    padding: 3px 8px; border-radius: 6px; border: 1px solid var(--border);
    background: var(--surface-2); color: var(--muted); font-size: 11px; cursor: pointer;
  }
  .search-results { flex: 1; overflow-y: auto; padding: 8px; min-height: 80px; }
  .result-group { margin-bottom: 6px; }
  .result-group-title {
    padding: 8px 12px 4px; font-size: 11px; font-weight: 600;
    color: var(--muted); letter-spacing: .04em;
  }
  .result-item {
    display: flex; align-items: center; gap: 14px; padding: 10px 12px;
    border-radius: 10px; cursor: pointer; transition: background .14s;
  }
  .result-item:hover, .result-item.selected { background: var(--accent-soft); }
  .result-icon {
    width: 34px; height: 34px; border-radius: 9px; flex-shrink: 0;
    display: grid; place-items: center; font-size: 15px;
    background: var(--surface-2); border: 1px solid var(--border);
  }
  .result-body { min-width: 0; flex: 1; }
  .result-title {
    font-size: 14px; font-weight: 600; color: var(--text);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .result-item.selected .result-title, .result-item:hover .result-title { color: var(--accent); }
  .result-desc {
    font-size: 12px; color: var(--muted); line-height: 1.5;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .result-type { font-size: 11px; color: var(--muted); flex-shrink: 0; }
  .search-empty { padding: 36px 16px; text-align: center; color: var(--muted); font-size: 14px; }
  .search-empty b { color: var(--text); }
  .search-footer {
    display: flex; gap: 18px; padding: 10px 18px;
    border-top: 1px solid var(--border); background: var(--surface-2);
    font-size: 11px; color: var(--muted);
  }
  .search-footer kbd {
    display: inline-block; min-width: 18px; text-align: center;
    padding: 1px 5px; border-radius: 5px; border: 1px solid var(--border);
    background: var(--surface); font-family: inherit; font-size: 10px;
  }
  @media (max-width: 620px) {
    .search-overlay { padding: 8vh 12px 12px; }
    .search-footer { display: none; }
  }
</style>

<script>
  type SearchItem = {
    title: string; desc: string; category: string;
    tags: string[]; url: string; type: string;
  };

  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const typeIcons: Record<string, string> = {
    '文章': '文', '游戏': '玩', '提示词': '✦', '页面': '页',
  };
  let index: SearchItem[] = [];
  let selected = 0;
  let current: SearchItem[] = [];

  function close() {
    if (!overlay) return;
    overlay.hidden = true;
    document.body.style.overflow = '';
  }

  function open() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    input.value = '';
    selected = 0;
    render('');
    input.focus();
  }

  function render(keyword: string) {
    if (!results) return;
    const kw = keyword.trim().toLowerCase();
    current = !kw
      ? index.filter((it) => it.type === '页面')
      : index.filter((it) =>
          [it.title, it.desc, it.category, ...it.tags, it.type].join(' ').toLowerCase().includes(kw)
        ).slice(0, 12);

    if (current.length === 0) {
      results.innerHTML = `<div class="search-empty">没有找到匹配内容<br>换个关键词试试</div>`;
      return;
    }

    const groups: Record<string, SearchItem[]> = {};
    current.forEach((it) => {
      (groups[it.type] ??= []).push(it);
    });
    selected = Math.min(selected, current.length - 1);

    let flat = -1;
    results.innerHTML = Object.entries(groups).map(([type, items]) =>
      `<div class="result-group">
        <div class="result-group-title">${type}</div>
        ${items.map((it) => {
          flat++;
          const i = flat;
          const title = it.title.replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]!));
          const desc = it.desc.replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]!));
          return `<div class="result-item${i === selected ? ' selected' : ''}" data-index="${i}" role="option" aria-selected="${i === selected}">
            <span class="result-icon">${typeIcons[type] ?? '·'}</span>
            <span class="result-body">
              <span class="result-title">${title}</span>
              <span class="result-desc">${desc}</span>
            </span>
            <span class="result-type">${it.category}</span>
          </div>`;
        }).join('')}
      </div>`
    ).join('');

    results.querySelectorAll<HTMLElement>('.result-item').forEach((el) => {
      el.addEventListener('mouseenter', () => setSelected(Number(el.dataset.index)));
      el.addEventListener('click', () => go(Number(el.dataset.index)));
    });
  }

  function setSelected(i: number) {
    const items = results?.querySelectorAll<HTMLElement>('.result-item');
    if (!items) return;
    items.forEach((el) => {
      const on = Number(el.dataset.index) === i;
      el.classList.toggle('selected', on);
      el.setAttribute('aria-selected', String(on));
    });
    selected = i;
    items[i]?.scrollIntoView({ block: 'nearest' });
  }

  function go(i: number) {
    const item = current[i];
    if (!item) return;
    close();
    location.href = item.url;
  }

  fetch('/search-index.json')
    .then((r) => r.json())
    .then((data: SearchItem[]) => { index = Array.isArray(data) ? data : []; })
    .catch(() => { index = []; });

  input?.addEventListener('input', () => { selected = 0; render(input.value); });
  overlay?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (overlay?.hidden) open(); else close();
      return;
    }
    if (overlay?.hidden) return;
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); if (current.length) setSelected((selected + 1) % current.length); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (current.length) setSelected((selected - 1 + current.length) % current.length); }
    else if (e.key === 'Enter') { e.preventDefault(); go(selected); }
  });

  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement)?.closest('[data-search-open]');
    if (trigger) { e.preventDefault(); open(); }
  });
</script>
